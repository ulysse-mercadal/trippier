  "item": [
    {
      "name": "Setup: Create User A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomStr = Math.random().toString(36).substring(7);",
              "pm.environment.set(\"user_a_email\", `user_a_${randomStr}@test.com`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"User A Registered\", () => pm.response.to.have.status(201));",
              "const jsonData = pm.response.json();",
              "pm.environment.set(\"user_a_token\", jsonData.access_token);",
              "pm.environment.set(\"user_a_id\", jsonData.user.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{user_a_email}}\", \"password\": \"password123\", \"name\": \"User A\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
