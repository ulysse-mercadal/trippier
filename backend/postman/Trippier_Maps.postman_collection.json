    {
      "name": "User A: Get Private Map (Check Simplified POIs)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const jsonData = pm.response.json();",
              "pm.test(\"Has POIs\", () => pm.expect(jsonData.pois.length).to.be.above(0));",
              "const poi = jsonData.pois[0];",
              "pm.test(\"POI has simplified fields\", () => {",
              "    pm.expect(poi).to.have.property('id');",
              "    pm.expect(poi).to.have.property('lat');",
              "    pm.expect(poi).to.have.property('lng');",
              "    pm.expect(poi).to.not.have.property('description');",
              "    pm.expect(poi).to.not.have.property('rating');",
              "});"
            ],
            "type": "text/javascript"
